{
  "name": "collab-whiteboard",
  "version": "1.0.0",
  "description": "WebSocket 기반 실시간 협업 화이트보드 — 동시 편집, 끊겨도 이어지는 동기화, 내 작업만 실행 취소",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Jeonghyeock Kim",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"node --watch server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "node server/main.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
